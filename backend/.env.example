# NASA FIRMS API Integration
# Register for a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave empty to automatically use labeled simulation/demo mode.
FIRMS_MAP_KEY=
# Configurable satellite source: VIIRS_SNPP (default), VIIRS_NOAA20, VIIRS_NOAA21, or MODIS
FIRMS_SOURCE=VIIRS_SNPP

# Alert channels
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

MOBILE_WEBHOOK_URL=
MOBILE_WEBHOOK_API_KEY=

# Cloud provider (local | aws | gcp)
CLOUD_PROVIDER=local
CLOUD_BUCKET=firewatch-events
AWS_REGION=us-east-1

# AI models
ENABLE_YOLOV8=true
YOLOV8_MODEL_PATH=yolov8n.pt
YOLO_FIRE_CLASS_NAMES=fire,smoke
YOLO_CONF_THRESHOLD=0.25

ENABLE_EFFICIENTNET=true
EFFICIENTNET_WEIGHTS_PATH=
